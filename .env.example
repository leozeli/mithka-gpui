# Process environment read by mithka-gpui, mithka-tdlib-spike, and mithka-gtk.
# This file is an example. The binaries do not load it automatically.
# Copy to .env or run.env (both gitignored), fill in, then: set -a; source .env; set +a
# Flags --api-id and --api-hash override these variables.
# Use the same api_id / api_hash that created the Mithka session.
TDLIB_API_ID=
TDLIB_API_HASH=

